    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-modulith.version>1.4.14</spring-modulith.version>
        <springdoc-openapi-starter.version>2.10.0</springdoc-openapi-starter.version>
        <org.mapstruct.version>1.5.3.Final</org.mapstruct.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <khinemyaezin.nested-set.version>1.1.0</khinemyaezin.nested-set.version>
        <joda-money.version>2.0.0</joda-money.version>
        <jjwt.version>0.12.5</jjwt.version>
        <aws-sdk.version>2.29.45</aws-sdk.version>
        <assertj-core.version>3.27.7</assertj-core.version>
        <tomcat.version>10.1.61</tomcat.version>
        <netty.version>4.1.140.Final</netty.version>
        <commons-lang3.version>3.21.0</commons-lang3.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <postgresql.version>42.7.12</postgresql.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <log4j-bom.version>2.25.5</log4j-bom.version>
        <dependency-check.version>13.0.0</dependency-check.version>

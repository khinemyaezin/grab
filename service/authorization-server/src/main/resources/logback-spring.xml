<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="authorization-server"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} service=${serviceName} level=%-5level traceId=%X{traceId:-} eventId=%X{eventId:-} logger=%logger{36} - %msg%n"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${LOG_PATTERN}</pattern></encoder>
    </appender>
    <root level="${LOGGING_LEVEL_ROOT:-INFO}"><appender-ref ref="CONSOLE"/></root>
</configuration>

<configuration>
    <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_FILE_ENABLED" source="logger.file.enabled" defaultValue="false"/>
    <springProperty scope="context" name="LOG_PATH" source="logger.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="LOG_FILE" source="logger.file.name" defaultValue="checkout-service.log"/>
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="checkout-service"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${SERVICE_NAME}] [%thread] [traceId=%X{traceId:-}] [eventId=%X{eventId:-}] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <if condition='property("LOG_FILE_ENABLED").equals("true")'>
        <then>
            <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_PATH}/${LOG_FILE}</file>
                <encoder>
                    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${SERVICE_NAME}] [%thread] [traceId=%X{traceId:-}] [eventId=%X{eventId:-}] %logger{40} - %msg%n</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_PATH}/archive/checkout-service-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                    <maxFileSize>10MB</maxFileSize>
                    <maxHistory>14</maxHistory>
                    <totalSizeCap>1GB</totalSizeCap>
                </rollingPolicy>
            </appender>
        </then>
    </if>

    <if condition='property("LOG_FILE_ENABLED").equals("true")'>
        <then>
            <root level="${ROOT_LEVEL}">
                <appender-ref ref="CONSOLE"/>
                <appender-ref ref="FILE"/>
            </root>
        </then>
        <else>
            <root level="${ROOT_LEVEL}">
                <appender-ref ref="CONSOLE"/>
            </root>
        </else>
    </if>
</configuration>

# Seller BFF runtime profile and public browser boundary.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SECURITY_API_CORS=http://localhost:3000
SECURITY_API_CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
SECURITY_API_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-TOKEN
LOGGING_LEVEL_ROOT=INFO

# Public issuer identity is used for browser redirects and ID-token validation.
# The metadata and backchannel endpoints can use private Docker DNS names.
SELLER_OIDC_ISSUER=http://localhost:9000
GRAB_SELLER_OIDC_METADATA_URI=http://authorization-server:9000/.well-known/openid-configuration
GRAB_SELLER_OIDC_AUTHORIZATION_ENDPOINT=http://localhost:9000/oauth2/authorize
GRAB_SELLER_OIDC_TOKEN_ENDPOINT=http://authorization-server:9000/oauth2/token
GRAB_SELLER_OIDC_JWK_SET_ENDPOINT=http://authorization-server:9000/oauth2/jwks
GRAB_SELLER_OIDC_INTROSPECTION_ENDPOINT=http://authorization-server:9000/oauth2/introspect
GRAB_SELLER_OIDC_REVOCATION_ENDPOINT=http://authorization-server:9000/oauth2/revoke
GRAB_SELLER_OIDC_LOGOUT_ENDPOINT=http://authorization-server:9000/connect/logout
SELLER_OIDC_AUDIENCE=grab-seller-api
SELLER_OIDC_SCOPES=openid,profile,email
SELLER_OIDC_CLIENT_ID=seller-bff
SELLER_OIDC_RESOURCE_CLIENT_ID=seller-bff
SELLER_OIDC_CALLBACK=http://localhost:8080/login/oauth2/code/seller
SELLER_OIDC_UI=http://localhost:3000/
SELLER_OIDC_POST_LOGOUT_URI=http://localhost:3000/
SELLER_OIDC_SECURE_COOKIES=false
SELLER_OIDC_REDIS_NAMESPACE=grab:seller:dev
SELLER_OIDC_SESSION_TIMEOUT=7d
SELLER_OIDC_REFRESH_SKEW=5s
SELLER_OIDC_LOCK_TTL=30s
SELLER_OIDC_CONNECT_TIMEOUT=2s
SELLER_OIDC_READ_TIMEOUT=6s
SELLER_OIDC_REVOCATION_RETRY_DELAY=30s
SELLER_OIDC_REVOCATION_TOKEN_TTL=7d
SELLER_OIDC_REVOCATION_CLAIM_LEASE=60s
SELLER_OIDC_REVOCATION_BATCH_SIZE=25
SELLER_OIDC_REDIS_URL=redis://authorization-redis:6379
SELLER_OIDC_REDIS_USERNAME=
SELLER_OIDC_REDIS_SSL=false

# The p12 files are mounted under /run/secrets/seller-auth.
# Supply the passwords through the deployment secret source/config tree.
SELLER_AUTH_ACCOUNT_HOST=account-service
SELLER_AUTH_REGISTRATION_PORT=1200
SELLER_AUTH_CLIENT_KEYSTORE=/run/secrets/seller-auth/client.p12
SELLER_AUTH_CLIENT_TRUSTSTORE=/run/secrets/seller-auth/account-trust.p12
SELLER_AUTH_CONNECT_TIMEOUT=2s
SELLER_AUTH_READ_TIMEOUT=6s

GRAB_RPC_CLIENTS_ACCOUNT_HOST=account-service
GRAB_RPC_CLIENTS_ACCOUNT_PORT=1099
GRAB_RPC_CLIENTS_MERCHANDISING_HOST=merchandising-service
GRAB_RPC_CLIENTS_MERCHANDISING_PORT=1100
GRAB_RPC_CLIENTS_CHANNEL_HOST=channel-service
GRAB_RPC_CLIENTS_CHANNEL_PORT=1101

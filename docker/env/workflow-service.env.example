# Development only. Copy to workflow-service.env and replace values for deployment.
SPRING_PROFILES_ACTIVE=dev

WORKFLOW_DB_URL=jdbc:postgresql://workflow-db:5432/order_management
WORKFLOW_DB_USERNAME=admin
WORKFLOW_DB_PASSWORD=123
WORKFLOW_DB_DRIVER=org.postgresql.Driver
WORKFLOW_HIKARI_MAXIMUM_POOL_SIZE=10
WORKFLOW_HIKARI_MIN_IDLE=2
WORKFLOW_HIKARI_CONNECTION_TIMEOUT=30000
WORKFLOW_HIKARI_IDLE_TIMEOUT=600000
WORKFLOW_HIKARI_MAX_LIFETIME=1800000

LOGGER_BACKEND=slf4j
LOGGER_FAIL_ON_MISSING_BACKEND=false
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=logs
LOGGER_FILE_NAME=workflow-service.log
LOGGING_LEVEL_ROOT=INFO
SCHEDULER_POOL_SIZE=4

WORKFLOW_WORKERS_ENABLED=true
WORKFLOW_STARTS_ENABLED=true
WORKFLOW_TIMER_FIXED_DELAY_MS=1000
WORKFLOW_TIMER_LEASE=PT60S

# Only enable RMI on a private network with a resolvable advertised host.
GRAB_RPC_ENABLED=false
GRAB_RPC_REGISTRY_PORT=1103
GRAB_RPC_BIND_ADDRESS=0.0.0.0
GRAB_RPC_ADVERTISED_HOST=workflow-service
GRAB_RPC_CONNECT_TIMEOUT_MS=3000
GRAB_RPC_READ_TIMEOUT_MS=30000

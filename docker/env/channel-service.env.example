# Development only. Copy to channel-service.env and replace values for deployment.
SPRING_PROFILES_ACTIVE=dev

CHANNEL_DB_URL=jdbc:postgresql://channel-db:5432/channel_context
CHANNEL_DB_USERNAME=admin
CHANNEL_DB_PASSWORD=123
CHANNEL_DB_DRIVER=org.postgresql.Driver
CHANNEL_HIKARI_MAXIMUM_POOL_SIZE=10
CHANNEL_HIKARI_MIN_IDLE=2
CHANNEL_HIKARI_CONNECTION_TIMEOUT=30000
CHANNEL_HIKARI_IDLE_TIMEOUT=600000
CHANNEL_HIKARI_MAX_LIFETIME=1800000

LOGGER_BACKEND=slf4j
LOGGER_FAIL_ON_MISSING_BACKEND=false
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=logs
LOGGER_FILE_NAME=channel-service.log
LOGGING_LEVEL_ROOT=INFO
SCHEDULER_POOL_SIZE=4

BOOTSTRAP_GATE_READINESS=false
BOOTSTRAP_MAX_ATTEMPTS=5
BOOTSTRAP_INITIAL_BACKOFF=2s
BOOTSTRAP_MAX_BACKOFF=30s
BOOTSTRAP_LOCK_POLL_INTERVAL=2s
SECURITY_MANIFEST_REPUBLISH_INITIAL_DELAY_MS=300000
SECURITY_MANIFEST_REPUBLISH_FIXED_DELAY_MS=300000

JOBS_DISCOVERY_REBUILD_ENABLED=false
JOBS_DISCOVERY_REBUILD_EXIT_ON_COMPLETION=true
STOREFRONTQUERY_REBUILD_BATCH_SIZE=100

# Only enable RMI on a private network with a resolvable advertised host.
GRAB_RPC_ENABLED=false
GRAB_RPC_REGISTRY_PORT=1101
GRAB_RPC_BIND_ADDRESS=0.0.0.0
GRAB_RPC_ADVERTISED_HOST=channel-service
GRAB_RPC_CONNECT_TIMEOUT_MS=3000
GRAB_RPC_READ_TIMEOUT_MS=30000
GRAB_RPC_CLIENTS_MERCHANDISING_HOST=merchandising-service
GRAB_RPC_CLIENTS_MERCHANDISING_PORT=1100

SPRING_PROFILES_ACTIVE=dev
AUTHORIZATION_PORT=9000
AUTHORIZATION_DB_URL=jdbc:postgresql://identity-account-db:5432/authorization
AUTHORIZATION_DB_USERNAME=authorization_server
AUTHORIZATION_DB_PASSWORD=replace-me
AUTHORIZATION_DB_SCHEMA=authorization_server
AUTHORIZATION_DB_POOL_SIZE=12
AUTHORIZATION_DB_MIN_IDLE=2
AUTHORIZATION_DB_TIMEOUT_MS=3000
AUTHORIZATION_REDIS_URL=redis://seller-auth-redis:6379
AUTHORIZATION_SECURE_COOKIES=false
AUTHORIZATION_SESSION_TIMEOUT=7d
AUTHORIZATION_SESSION_COOKIE_NAME=GRAB_ISSUER_SESSION

SELLER_OIDC_ISSUER=http://localhost:9000
SELLER_OIDC_CLIENT_ID=seller-bff
# Store a delegated BCrypt encoding of the same confidential client secret used by Seller BFF.
# In compose files, single-quote BCrypt hashes to avoid variable expansion of dollar signs.
SELLER_OIDC_CLIENT_SECRET_HASH='{bcrypt}replace-with-bcrypt-hash'
SELLER_OIDC_CALLBACK=http://localhost:8080/login/oauth2/code/seller
SELLER_OIDC_POST_LOGOUT_URI=http://localhost:3000/
SELLER_OIDC_AUDIENCE=grab-seller-api
SELLER_OIDC_ACCESS_TOKEN_TTL=PT15M
SELLER_OIDC_REFRESH_TOKEN_TTL=P7D
SELLER_OIDC_CLEANUP_DELAY=PT1H
SELLER_OIDC_TOKEN_RETENTION=P1D
SELLER_OIDC_SCOPES=openid
SELLER_OIDC_CLIENT_INIT_ADVISORY_LOCK=6021278

SELLER_AUTH_ACCOUNT_HOST=account-service
SELLER_AUTH_ACCOUNT_PORT=1199
SELLER_AUTH_CONNECT_TIMEOUT_MS=1500
SELLER_AUTH_READ_TIMEOUT_MS=3000
SELLER_AUTH_RATE_LIMIT_MAX=30
SELLER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

SELLER_OIDC_SIGNING_KEYSTORE=/run/secrets/issuer/signing.p12
SELLER_OIDC_SIGNING_PASSWORD=replace-me
SELLER_OIDC_SIGNING_ALIAS=seller-current
SELLER_OIDC_RETIRING_ALIASES=
SELLER_AUTH_CLIENT_KEYSTORE=/run/secrets/issuer/client.p12
SELLER_AUTH_CLIENT_KEY_PASSWORD=replace-me
SELLER_AUTH_CLIENT_TRUSTSTORE=/run/secrets/issuer/account-trust.p12
SELLER_AUTH_CLIENT_TRUST_PASSWORD=replace-me

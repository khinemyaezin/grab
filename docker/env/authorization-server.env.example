SPRING_PROFILES_ACTIVE=dev
AUTHORIZATION_DB_URL=jdbc:postgresql://postgres:5432/authorization
AUTHORIZATION_DB_USERNAME=authorization_server
AUTHORIZATION_DB_PASSWORD=replace-me
AUTHORIZATION_DB_SCHEMA=authorization_server
AUTHORIZATION_DB_POOL_SIZE=12
AUTHORIZATION_DB_MIN_IDLE=2
AUTHORIZATION_DB_TIMEOUT_MS=3000
AUTHORIZATION_REDIS_URL=redis://authorization-redis:6379
AUTHORIZATION_SECURE_COOKIES=false
AUTHORIZATION_SESSION_TIMEOUT=7d
AUTHORIZATION_SESSION_COOKIE_NAME=GRAB_ISSUER_SESSION

AUTHORIZATION_ISSUER=http://localhost:9000
AUTHORIZATION_ACCESS_TOKEN_TTL=PT15M
AUTHORIZATION_REFRESH_TOKEN_TTL=P7D
AUTHORIZATION_CLEANUP_DELAY=PT1H
AUTHORIZATION_TOKEN_RETENTION=P1D
AUTHORIZATION_CLIENT_INIT_ADVISORY_LOCK=6021278

# Use the delegated BCrypt encoding of the BFF's client secret.
# Single quotes preserve the dollar signs in Compose env files.
AUTHORIZATION_CLIENT_0_SECRET_HASH='{bcrypt}replace-with-bcrypt-hash'

AUTHORIZATION_ACCOUNT_HOST=account-service
AUTHORIZATION_ACCOUNT_PORT=1199
AUTHORIZATION_CONNECT_TIMEOUT_MS=1500
AUTHORIZATION_READ_TIMEOUT_MS=3000
AUTHORIZATION_RATE_LIMIT_MAX=30
AUTHORIZATION_RATE_LIMIT_WINDOW_SECONDS=60
AUTHORIZATION_SIGNING_KEYSTORE=/run/secrets/issuer/signing.p12
AUTHORIZATION_SIGNING_PASSWORD=replace-me
AUTHORIZATION_SIGNING_ALIAS=issuer-current
AUTHORIZATION_RETIRING_ALIASES=
AUTHORIZATION_CLIENT_KEYSTORE=/run/secrets/issuer/client.p12
AUTHORIZATION_CLIENT_KEY_PASSWORD=replace-me
AUTHORIZATION_CLIENT_TRUSTSTORE=/run/secrets/issuer/account-trust.p12
AUTHORIZATION_CLIENT_TRUST_PASSWORD=replace-me

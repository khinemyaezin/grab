# Standalone account-service development settings.
# Use with `docker run --env-file docker/env/account-service.env ...` on the
# Docker network that contains the PostgreSQL and channel services.
SPRING_PROFILES_ACTIVE=dev

ACCOUNT_DB_URL=jdbc:postgresql://identity-account-db:5432/account
ACCOUNT_DB_USERNAME=admin
ACCOUNT_DB_PASSWORD=123
ACCOUNT_DB_DRIVER=org.postgresql.Driver

ACCOUNT_HIKARI_MAXIMUM_POOL_SIZE=10
ACCOUNT_HIKARI_MIN_IDLE=2
ACCOUNT_HIKARI_CONNECTION_TIMEOUT=30000
ACCOUNT_HIKARI_IDLE_TIMEOUT=600000
ACCOUNT_HIKARI_MAX_LIFETIME=1800000

JWT_ISSUER=https://identity.local.grab
JWT_AUDIENCE=grab-commerce-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Set these for the prod profile and mount the PKCS#12 file at this path.
JWT_KEYSTORE_PATH=
JWT_KEYSTORE_PASSWORD=
JWT_KEY_ALIAS=account-service

BOOTSTRAP_GATE_READINESS=false
SECURITY_MANIFEST_REPUBLISH_INITIAL_DELAY_MS=300000
SECURITY_MANIFEST_REPUBLISH_FIXED_DELAY_MS=300000
SECURITY_MANIFEST_REVALIDATION_FIXED_DELAY_MS=30000
SECURITY_MANIFEST_REVALIDATION_BATCH_SIZE=100

LOGGER_BACKEND=slf4j
LOGGER_FAIL_ON_MISSING_BACKEND=false
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=logs
LOGGER_FILE_NAME=account-service.log
LOGGING_LEVEL_ROOT=INFO

# Keep RMI disabled until the service is registered on a network reachable by
# its consumers. When enabled, set the advertised host to this container's DNS
# name and configure the Channel RMI client when merchant onboarding is used.
GRAB_RPC_ENABLED=false
GRAB_RPC_REGISTRY_PORT=1099
GRAB_RPC_BIND_ADDRESS=0.0.0.0
GRAB_RPC_ADVERTISED_HOST=account-service
GRAB_RPC_CLIENTS_CHANNEL_HOST=channel-service
GRAB_RPC_CLIENTS_CHANNEL_PORT=1099

SELLER_AUTH_RPC_ENABLED=false
SELLER_AUTH_RPC_KEYSTORE=/run/secrets/seller-auth/server.p12
SELLER_AUTH_RPC_KEY_PASSWORD=
SELLER_AUTH_RPC_ISSUER_TRUSTSTORE=/run/secrets/seller-auth/issuer-peers.p12
SELLER_AUTH_RPC_BFF_TRUSTSTORE=/run/secrets/seller-auth/bff-peers.p12
SELLER_AUTH_RPC_TRUST_PASSWORD=

# Development only. Copy to checkout-service.env and replace values for deployment.
SPRING_PROFILES_ACTIVE=dev

CHECKOUT_DB_URL=jdbc:postgresql://checkout-db:5432/order_management
CHECKOUT_DB_USERNAME=admin
CHECKOUT_DB_PASSWORD=123
CHECKOUT_DB_DRIVER=org.postgresql.Driver
CHECKOUT_HIKARI_MAXIMUM_POOL_SIZE=20
CHECKOUT_HIKARI_MIN_IDLE=5
CHECKOUT_HIKARI_CONNECTION_TIMEOUT=30000
CHECKOUT_HIKARI_IDLE_TIMEOUT=600000
CHECKOUT_HIKARI_MAX_LIFETIME=1800000

LOGGER_BACKEND=slf4j
LOGGER_FAIL_ON_MISSING_BACKEND=false
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=logs
LOGGER_FILE_NAME=checkout-service.log
LOGGING_LEVEL_ROOT=INFO
SCHEDULER_POOL_SIZE=4

# Only enable RMI on a private network with a resolvable advertised host.
GRAB_RPC_ENABLED=false
GRAB_RPC_REGISTRY_PORT=1102
GRAB_RPC_BIND_ADDRESS=0.0.0.0
GRAB_RPC_ADVERTISED_HOST=checkout-service
GRAB_RPC_CONNECT_TIMEOUT_MS=3000
GRAB_RPC_READ_TIMEOUT_MS=30000
GRAB_RPC_CLIENTS_CHANNEL_HOST=channel-service
GRAB_RPC_CLIENTS_CHANNEL_PORT=1101
GRAB_RPC_CLIENTS_MERCHANDISING_HOST=merchandising-service
GRAB_RPC_CLIENTS_MERCHANDISING_PORT=1100

# Development only. Copy to merchandising-service.env and replace values for deployment.
SPRING_PROFILES_ACTIVE=dev

MERCHANDISING_DB_URL=jdbc:postgresql://merchandising-db:5432/product_merchandising
MERCHANDISING_DB_USERNAME=admin
MERCHANDISING_DB_PASSWORD=123
MERCHANDISING_DB_DRIVER=org.postgresql.Driver
MERCHANDISING_HIKARI_MAXIMUM_POOL_SIZE=15
MERCHANDISING_HIKARI_MIN_IDLE=3
MERCHANDISING_HIKARI_CONNECTION_TIMEOUT=30000
MERCHANDISING_HIKARI_IDLE_TIMEOUT=600000
MERCHANDISING_HIKARI_MAX_LIFETIME=1800000

LOGGER_BACKEND=slf4j
LOGGER_FAIL_ON_MISSING_BACKEND=false
LOGGER_FILE_ENABLED=false
LOGGER_FILE_PATH=logs
LOGGER_FILE_NAME=merchandising-service.log
LOGGING_LEVEL_ROOT=INFO
SCHEDULER_POOL_SIZE=4

BOOTSTRAP_GATE_READINESS=false
BOOTSTRAP_MAX_ATTEMPTS=5
BOOTSTRAP_INITIAL_BACKOFF=2s
BOOTSTRAP_MAX_BACKOFF=30s
BOOTSTRAP_LOCK_POLL_INTERVAL=2s
SECURITY_MANIFEST_REPUBLISH_INITIAL_DELAY_MS=300000
SECURITY_MANIFEST_REPUBLISH_FIXED_DELAY_MS=300000

# Development S3-compatible endpoint. Set deployment credentials separately.
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=grab-media
STORAGE_S3_ACCESS_KEY=s3admin
STORAGE_S3_SECRET_KEY=s3secret
STORAGE_S3_PUBLIC_BASE_URL=http://localhost:8333/grab-media
STORAGE_S3_PRESIGN_TTL=PT15M
STORAGE_S3_KEY_PREFIX=
STORAGE_UPLOAD_MAX_SIZE_BYTES=10485760

# Only enable RMI on a private network with a resolvable advertised host.
GRAB_RPC_ENABLED=false
GRAB_RPC_REGISTRY_PORT=1100
GRAB_RPC_BIND_ADDRESS=0.0.0.0
GRAB_RPC_ADVERTISED_HOST=merchandising-service
GRAB_RPC_CONNECT_TIMEOUT_MS=3000
GRAB_RPC_READ_TIMEOUT_MS=30000
